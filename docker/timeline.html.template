<!--

Template/header for a timeline visualization of a multi-container build.
The timelines represent interesting log lines, with one row per container.
The charts represent CPU usage within those containers.

To use this, concatenate this with a '<script>' block defining
a global variable named data.

The expected format of data is exemplified by the following,
and is tightly coupled with the implementation generating
it in monitor.py. The intention of this unfriendly file format
is to do as much munging as plausible in Python.

To make the visualization relative to the start time (i.e., to say that all
builds start at 00:00), the timestamps are all seconds since the build began.
To make the visualization work with them, the timestamps are then converted
into local time, and get displayed reasonably. This is a workaround to the fact
that the visualization library for the timelines does not accept any data types
that represent duration, but we still want timestamp-style formatting.

var data = {
  // max timestamp seen, in seconds since the epoch
  "max_ts": 8153.0,
  // map of container name to an array of metrics
  "metrics": {
    "i-20180312-140548-ee-test-serial": [
      // a single metric point is an array of timestamp, user CPU, system CPU
      // CPU is the percent of 1 CPU used since the previous timestamp.
      [
        4572.0,
        0.11,
        0.07
      ]
    ]
  },
  // Array of timelines
  "timeline": [
    // a timeline entry contains a name (for the entire row of the timeline),
    // the message (for a segment of the timeline), and start and end timestamps
    // for the segment.
    [
      "i-20180312-140548",
      "+ echo '>>> build' '4266 (begin)'",
      0.0,
      0.0
    ]
  ]
}
-->

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

<script type="text/javascript">
google.charts.load("current", {packages:["timeline", "corechart"]});
google.charts.setOnLoadCallback(drawChart);

function ts_to_hms(secs) {
  var s = secs % 60;
  var m = Math.floor(secs / 60) % 60;
  var h = Math.floor(secs / (60 * 60));
  return [h, m, s];
}

/* Returns a Date object corresponding to secs seconds since the epoch, in
 * localtime. Date(x) and Date(0, 0, 0, 0, 0, 0, 0, x) differ in that the
 * former returns UTC whereas the latter returns the browser local time.
 * For consistent handling within this visualization, we use localtime.
 *
 * Beware that local time can be discontinuous around time changes.
 */
function ts_to_date(secs) {
  // secs may be a float, so we use millis as a common denominator unit
  var millis = 1000 * secs;
  return new Date(1970 /* yr; beginning of unix epoch */, 0 /* mo */, 0 /* d */,
      0 /* hr */, 0 /* min */, 0 /* sec */, millis);
}

function drawChart() {
  var timelineContainer = document.getElementById('timelineContainer');
  var chart = new google.visualization.Timeline(timelineContainer);
  var dataTable = new google.visualization.DataTable();
  dataTable.addColumn({ type: 'string', id: 'Position' });
  dataTable.addColumn({ type: 'string', id: 'Name' });
  // timeofday isn't supported here
  dataTable.addColumn({ type: 'datetime', id: 'Start' });
  dataTable.addColumn({ type: 'datetime', id: 'End' });

  // Extract the build name, which is a common prefix of the container names.
  // Add one to the length we know that the driver script adds a hyphen when building
  //the container names.
  var buildnamePrefix = data.buildname;
  var commonPrefix = buildnamePrefix.length + 1;
  // Timeline
  const rowLabels = new Set();
  for (i = 0; i < data.timeline.length; ++i) {
    var row = data.timeline[i];
    // Hack up the label in row[0]: cut off the common prefix, which is the build
    // name. This is the same for all shards, so it is not useful for the charts.
    var rowLabel = row[0].slice(commonPrefix);
    if (rowLabel == "") rowLabel = ' -- ';
    dataTable.addRow([ rowLabel, row[1], ts_to_date(row[2]), ts_to_date(row[3]) ]);
    rowLabels.add(rowLabel);
  }
  // Precompute timeline height to get rid of the timeline's own scrollbar.
  const laneHeight = 41;
  const axisHeight = 50;

  timelineHeight = rowLabels.size * laneHeight + axisHeight;
  var options = {
    // Width is specified in the <div> tag below; for some reason it doesn't have the
    // same effect when specified here.
    // Height is precomputed from the incoming data, so we set it here.
    height: timelineHeight,
    timeline: { showRowLabels : 'true' }
  };
  chart.draw(dataTable, options);

  // ========================================
  // CPU USAGE SECTION
  // ========================================
  
  // Create section header
  var cpuSectionHeader = document.createElement('h2');
  cpuSectionHeader.textContent = 'CPU Usage';
  cpuSectionHeader.style.marginTop = '30px';
  cpuSectionHeader.style.color = '#333';
  cpuSectionHeader.style.borderBottom = '2px solid #007acc';
  cpuSectionHeader.style.paddingBottom = '5px';
  lineChartContainer.appendChild(cpuSectionHeader);
  
  // Container CPU charts
  var containerCpuHeader = document.createElement('h3');
  containerCpuHeader.textContent = 'Containers';
  containerCpuHeader.style.color = '#555';
  containerCpuHeader.style.marginTop = '20px';
  containerCpuHeader.style.marginBottom = '10px';
  lineChartContainer.appendChild(containerCpuHeader);
  
  for (const k of Object.keys(data.metrics)) {
    var lineChart = document.createElement("div");
    lineChartContainer.appendChild(lineChart);

    var dataTable = new google.visualization.DataTable();
    dataTable.addColumn({ type: 'timeofday', label: 'Time', id: 'Time' });
    dataTable.addColumn({ type: 'number', label: 'User', id: 'User' });
    dataTable.addColumn({ type: 'number', label: 'System', id: 'System' });

    for (const row of data.metrics[k]) {
      dataTable.addRow([ ts_to_hms(row[0]), row[1], row[2] ]);
    }
    
    // De-clutter the timeline labels: Slice off the common prefix of the build name
    var title = k.slice(commonPrefix);
    if (title == "") title = ' -- ';
    var options = {
      title: 'CPU: ' + title,
      legend: { position: 'bottom' },
      hAxis: {
        minValue: [0, 0, 0],
        maxValue: ts_to_hms(data.max_ts)
      },
      vAxis: {
        title: 'CPU Usage (%)'
      },
      chartArea: {width: '95%'},
      backgroundColor: '#f8f9fa'
    };

    var chart = new google.visualization.LineChart(lineChart);
    chart.draw(dataTable, options);
  }
  
  // Host CPU chart
  var hostCpuHeader = document.createElement('h3');
  hostCpuHeader.textContent = 'Host';
  hostCpuHeader.style.color = '#555';
  hostCpuHeader.style.marginTop = '20px';
  hostCpuHeader.style.marginBottom = '10px';
  lineChartContainer.appendChild(hostCpuHeader);
  
  if (data.host_cpu && data.host_cpu.length > 0) {
    var hostCpuChart = document.createElement('div');
    hostCpuChart.id = 'hostCpuChart';
    lineChartContainer.appendChild(hostCpuChart);
    
    var hostCpuDataTable = new google.visualization.DataTable();
    hostCpuDataTable.addColumn({ type: 'timeofday', label: 'Time', id: 'Time' });
    hostCpuDataTable.addColumn({ type: 'number', label: 'User (%)', id: 'HostCpuUser' });
    hostCpuDataTable.addColumn({ type: 'number', label: 'System (%)', id: 'HostCpuSystem' });
    
    for (const row of data.host_cpu) {
      hostCpuDataTable.addRow([ ts_to_hms(row[0]), row[1], row[2] ]);
    }
    
    var hostCpuOptions = {
      title: 'Host CPU Usage',
      legend: { position: 'bottom' },
      hAxis: {
        minValue: [0, 0, 0],
        maxValue: ts_to_hms(data.max_ts),
        title: 'Time'
      },
      vAxis: {
        title: 'CPU Usage (%)',
        format: '#.## %'
      },
      chartArea: {width: '95%'},
      colors: ['#1f77b4', '#ff7f0e'],  // Blue for user, orange for system
      backgroundColor: '#f8f9fa'
    };
    
    var hostCpuChartObj = new google.visualization.LineChart(hostCpuChart);
    hostCpuChartObj.draw(hostCpuDataTable, hostCpuOptions);
  }
  
  // ========================================
  // MEMORY USAGE SECTION  
  // ========================================
  
  // Create section header
  var memorySectionHeader = document.createElement('h2');
  memorySectionHeader.textContent = 'Memory Usage';
  memorySectionHeader.style.marginTop = '40px';
  memorySectionHeader.style.color = '#333';
  memorySectionHeader.style.borderBottom = '2px solid #28a745';
  memorySectionHeader.style.paddingBottom = '5px';
  lineChartContainer.appendChild(memorySectionHeader);
  
  // Container Memory charts
  var containerMemoryHeader = document.createElement('h3');
  containerMemoryHeader.textContent = 'Containers';
  containerMemoryHeader.style.color = '#555';
  containerMemoryHeader.style.marginTop = '20px';
  containerMemoryHeader.style.marginBottom = '10px';
  lineChartContainer.appendChild(containerMemoryHeader);
  
  for (const k of Object.keys(data.metrics)) {
    // Create memory chart data table
    var memoryDataTable = new google.visualization.DataTable();
    memoryDataTable.addColumn({ type: 'timeofday', label: 'Time', id: 'Time' });
    memoryDataTable.addColumn({ type: 'number', label: 'Memory (MB)', id: 'Memory' });

    for (const row of data.metrics[k]) {
      if (row.length > 3) {  // Check if memory data is available
        memoryDataTable.addRow([ ts_to_hms(row[0]), row[3] ]);
      }
    }
    
    // Create memory chart if memory data is available
    if (memoryDataTable.getNumberOfRows() > 0) {
      var memoryChart = document.createElement('div');
      memoryChart.id = 'memoryChart' + k;
      lineChartContainer.appendChild(memoryChart);
      
      // De-clutter the timeline labels: Slice off the common prefix of the build name
      var title = k.slice(commonPrefix);
      if (title == "") title = ' -- ';
      
      var memoryOptions = {
        title: 'Memory: ' + title,
        legend: { position: 'bottom' },
        hAxis: {
          minValue: [0, 0, 0],
          maxValue: ts_to_hms(data.max_ts)
        },
        vAxis: {
          title: 'Memory (MB)'
        },
        chartArea: {width: '95%'},
        colors: ['#ff6600'],
        backgroundColor: '#f8f9fa'
      };
      
      var memoryChartObj = new google.visualization.LineChart(memoryChart);
      memoryChartObj.draw(memoryDataTable, memoryOptions);
    }
  }
  
  // Host Memory chart
  var hostMemoryHeader = document.createElement('h3');
  hostMemoryHeader.textContent = 'Host';
  hostMemoryHeader.style.color = '#555';
  hostMemoryHeader.style.marginTop = '20px';
  hostMemoryHeader.style.marginBottom = '10px';
  lineChartContainer.appendChild(hostMemoryHeader);
  
  if (data.host_memory && data.host_memory.length > 0) {
    var hostMemoryChart = document.createElement('div');
    hostMemoryChart.id = 'hostMemoryChart';
    lineChartContainer.appendChild(hostMemoryChart);
    
    var hostMemoryDataTable = new google.visualization.DataTable();
    hostMemoryDataTable.addColumn({ type: 'timeofday', label: 'Time', id: 'Time' });
    hostMemoryDataTable.addColumn({ type: 'number', label: 'Host Memory (GB)', id: 'HostMemory' });
    
    for (const row of data.host_memory) {
      hostMemoryDataTable.addRow([ ts_to_hms(row[0]), row[1] ]);
    }
    
    var hostMemoryOptions = {
      title: 'Host Memory Usage',
      legend: { position: 'bottom' },
      hAxis: {
        minValue: [0, 0, 0],
        maxValue: ts_to_hms(data.max_ts),
        title: 'Time'
      },
      vAxis: {
        title: 'Memory (GB)',
        format: '#.## GB'
      },
      chartArea: {width: '95%'},
      colors: ['#9932cc'],  // Purple color to distinguish from other charts
      backgroundColor: '#f8f9fa'
    };
    
    var hostMemoryChartObj = new google.visualization.LineChart(hostMemoryChart);
    hostMemoryChartObj.draw(hostMemoryDataTable, hostMemoryOptions);
  }
  
  // ========================================
  // DISK USAGE SECTION  
  // ========================================
  
  // Create section header
  var diskSectionHeader = document.createElement('h2');
  diskSectionHeader.textContent = 'Disk Usage';
  diskSectionHeader.style.marginTop = '40px';
  diskSectionHeader.style.color = '#333';
  diskSectionHeader.style.borderBottom = '2px solid #dc3545';
  diskSectionHeader.style.paddingBottom = '5px';
  lineChartContainer.appendChild(diskSectionHeader);
  
  // Container Disk charts
  var containerDiskHeader = document.createElement('h3');
  containerDiskHeader.textContent = 'Containers';
  containerDiskHeader.style.color = '#555';
  containerDiskHeader.style.marginTop = '20px';
  containerDiskHeader.style.marginBottom = '10px';
  lineChartContainer.appendChild(containerDiskHeader);
  
  // Create container disk usage charts
  for (const containerName in data.metrics) {
    const containerMetrics = data.metrics[containerName];
    if (containerMetrics.length === 0) continue;
    
    // Check if we have disk data (5th element in metrics array)
    const hasDiskData = containerMetrics.some(row => row.length > 4 && row[4] !== undefined && row[4] > 0);
    
    if (hasDiskData) {
      var containerDiskChart = document.createElement('div');
      containerDiskChart.id = containerName + 'DiskChart';
      lineChartContainer.appendChild(containerDiskChart);
      
      var containerDiskDataTable = new google.visualization.DataTable();
      containerDiskDataTable.addColumn({ type: 'timeofday', label: 'Time', id: 'Time' });
      containerDiskDataTable.addColumn({ type: 'number', label: containerName + ' Disk (MB)', id: 'ContainerDisk' });
      
      for (const row of containerMetrics) {
        if (row.length > 4 && row[4] !== undefined) {
          containerDiskDataTable.addRow([ ts_to_hms(row[0]), row[4] ]);
        }
      }
      
      // De-clutter the timeline labels: Slice off the common prefix of the build name
      var title = containerName.slice(commonPrefix);
      if (title == "") title = ' -- ';
      
      var containerDiskOptions = {
        title: 'Disk: ' + title,
        legend: { position: 'bottom' },
        hAxis: {
          minValue: [0, 0, 0],
          maxValue: ts_to_hms(data.max_ts),
          title: 'Time'
        },
        vAxis: {
          title: 'Disk (MB)',
          format: '#.## MB'
        },
        chartArea: {width: '95%'},
        colors: ['#20b2aa'],  // Light sea green color for container disk charts
        backgroundColor: '#f8f9fa'
      };
      
      var containerDiskChartObj = new google.visualization.LineChart(containerDiskChart);
      containerDiskChartObj.draw(containerDiskDataTable, containerDiskOptions);
    }
  }
  
  // Host Disk chart
  var hostDiskHeader = document.createElement('h3');
  hostDiskHeader.textContent = 'Host';
  hostDiskHeader.style.color = '#555';
  hostDiskHeader.style.marginTop = '20px';
  hostDiskHeader.style.marginBottom = '10px';
  lineChartContainer.appendChild(hostDiskHeader);
  
  if (data.host_disk && data.host_disk.length > 0) {
    var hostDiskChart = document.createElement('div');
    hostDiskChart.id = 'hostDiskChart';
    lineChartContainer.appendChild(hostDiskChart);
    
    var hostDiskDataTable = new google.visualization.DataTable();
    hostDiskDataTable.addColumn({ type: 'timeofday', label: 'Time', id: 'Time' });
    hostDiskDataTable.addColumn({ type: 'number', label: 'Host Disk (GB)', id: 'HostDisk' });
    
    for (const row of data.host_disk) {
      hostDiskDataTable.addRow([ ts_to_hms(row[0]), row[1] ]);
    }
    
    var hostDiskOptions = {
      title: 'Host Disk Usage',
      legend: { position: 'bottom' },
      hAxis: {
        minValue: [0, 0, 0],
        maxValue: ts_to_hms(data.max_ts),
        title: 'Time'
      },
      vAxis: {
        title: 'Disk (GB)',
        format: '#.## GB'
      },
      chartArea: {width: '95%'},
      colors: ['#ff6347'],  // Tomato color to distinguish from other charts
      backgroundColor: '#f8f9fa'
    };
    
    var hostDiskChartObj = new google.visualization.LineChart(hostDiskChart);
    hostDiskChartObj.draw(hostDiskDataTable, hostDiskOptions);
  }
}
</script>
<!-- Set width here, but leave height unset,
     it is computed above in the JavaScript code. -->
<div id="timelineContainer" style="width: 99%;"></div>
<div id="lineChartContainer" style="min-height: 400px;"></div>
     it is computed above in the JavaScript code. -->
<div id="timelineContainer" style="width: 99%;"></div>
<div id="lineChartContainer" style="height: 200px;"></div>

<!-- Test Results Section -->
<div style="margin-top: 30px;">
  <div style="cursor: pointer; padding: 10px; background-color: #f5f5f5; border: 1px solid #ddd; border-radius: 5px; user-select: none;" 
       onclick="toggleTestResults()">
    <h3 style="margin: 0; display: inline-block;">Test Results</h3>
    <span id="testToggle" style="float: right; font-weight: bold;">▼</span>
  </div>
  <div id="testResultsContent" style="display: none; border: 1px solid #ddd; border-top: none; padding: 20px; background-color: #fafafa;">
    <div id="testReportsContainer">
      <!-- Test reports will be inserted here by JavaScript -->
    </div>
  </div>
</div>

<script>
function toggleTestResults() {
  const content = document.getElementById('testResultsContent');
  const toggle = document.getElementById('testToggle');
  
  if (content.style.display === 'none') {
    content.style.display = 'block';
    toggle.textContent = '▲';
    // Load test reports when first opened
    if (!content.hasAttribute('data-loaded')) {
      loadTestReports();
      content.setAttribute('data-loaded', 'true');
    }
  } else {
    content.style.display = 'none';
    toggle.textContent = '▼';
  }
}

function loadTestReports() {
  // This will be populated by monitor.py with actual test report data
  const container = document.getElementById('testReportsContainer');
  if (typeof testReportData !== 'undefined' && testReportData) {
    container.innerHTML = testReportData;
  } else {
    container.innerHTML = '<p>No test reports available.</p>';
  }
}
</script>
